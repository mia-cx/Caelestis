{
  "name": "@caelestis/userscript",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node dev-inject.mjs --watch",
    "build:watch": "node build.mjs --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo",
