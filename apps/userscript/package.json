    "inject:watch": "node dev-inject.mjs --watch",
    "browser": "node chromium.mjs",
    "browser:relaunch": "node chromium.mjs --relaunch"
  },
  "dependencies": {
    "@caelestis/shared": "workspace:*",
    "@caelestis/ui": "workspace:*",
    "polygon-clipping": "0.15.7"
  },
  "devDependencies": {
    "@types/greasemonkey": "^4.0.7",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "undici": "8.11.0",
    "vitest": "^5.0.1"
  }
}
