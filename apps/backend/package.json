{
  "name": "@caelestis/backend",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "exports": {
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.bun.json",
    "start:node": "cd ../.. && node apps/backend/dist/node/main.js",
    "start:bun": "cd ../.. && bun apps/backend/dist/node/main.js",
    "check": "tsc -p tsconfig.check.json && tsc -p tsconfig.bun.json --noEmit && tsc -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "dev": "pnpm db:migrate:local && node dev.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:docker": "node scripts/test-integration-docker.mjs",
    "test:runtime": "vitest run --config vitest.runtime.config.ts && bun --bun node_modules/vitest/vitest.mjs run --config vitest.runtime.config.ts",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@caelestis/shared": "workspace:*",
    "@caelestis/social": "workspace:*",
    "@caelestis/storage": "workspace:*",
    "@caelestis/wire-schema": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "drizzle-orm": "0.45.4",
    "effect": "4.1.4",
    "fzstd": "0.1.1",
    "hono": "^4.13.18",
    "mariadb": "^3.5.5",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "miniflare": "5.20260918.0-alpha",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
