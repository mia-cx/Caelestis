{
  "name": "@caelestis/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svartz dev --vault docs",
    "build": "svartz build --vault docs",
    "preview": "svartz preview --vault docs",
    "deploy": "pnpm build && wrangler deploy",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf build .svartz .svelte-kit .turbo"
  },
  "devDependencies": {
    "@caelestis/ui": "workspace:*",
    "@lucide/svelte": "^1.61.0",
    "@svartz/config": "^1.1.0",
    "@svartz/theme-wiki": "^1.1.0",
    "@svartz/ui": "^1.1.0",
    "@svartz/vite": "^1.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svartz": "^1.0.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
