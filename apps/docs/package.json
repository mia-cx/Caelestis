{
  "name": "@caelestis/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svartz dev --vault docs",
    "build": "svartz build --vault docs",
    "preview": "svartz preview --vault docs",
    "deploy": "pnpm build && wrangler deploy",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf build .svartz .svelte-kit .turbo"
  },
  "devDependencies": {
    "@caelestis/ui": "workspace:*",
    "@lucide/svelte": "^1.73.0",
    "@svartz/config": "^2.6.0",
    "@svartz/theme-api-docs": "^2.6.0",
    "@svartz/theme-docs": "^2.6.0",
    "@svartz/theme-wiki": "^2.6.0",
    "@svartz/ui": "^2.6.0",
    "@svartz/vite": "^2.6.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svartz": "^2.6.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
