{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "strict": true,
    // svelte-check --tsgo types .svelte files reached through package.json imports as `any`
    // (sveltejs/language-tools#3142). The same mapping as a path alias keeps them typed.
    "paths": { "#lib/*": ["./src/lib/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
