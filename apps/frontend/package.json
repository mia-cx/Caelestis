{
  "name": "@caelestis/frontend",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo .svelte-kit"
  },
  "dependencies": {
    "@caelestis/shared": "workspace:*",
    "@caelestis/storage": "workspace:*",
    "@caelestis/ui": "workspace:*",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "fast-png": "^8.0.0",
    "gifenc": "^1.0.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@fontsource-variable/nunito": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "daisyui": "^5.7.43",
    "happy-dom": "20.14.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.2"
  }
}
