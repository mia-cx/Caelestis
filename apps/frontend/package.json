{
  "name": "@caelestis/frontend",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo .svelte-kit"
  },
  "dependencies": {
    "@caelestis/shared": "workspace:*",
    "@caelestis/social": "workspace:*",
    "@caelestis/storage": "workspace:*",
    "@caelestis/ui": "workspace:*",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@caelestis/backend": "workspace:*",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@fontsource-variable/nunito": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "daisyui": "^5.8.1",
    "happy-dom": "21.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
